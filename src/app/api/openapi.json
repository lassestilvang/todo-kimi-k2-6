{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskFlow API",
    "description": "Task management API with AI-powered task parsing, team collaboration, and productivity analytics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "tasks",
      "description": "Task management operations"
    },
    {
      "name": "lists",
      "description": "Task list management"
    },
    {
      "name": "labels",
      "description": "Task labeling and categorization"
    },
    {
      "name": "auth",
      "description": "Authentication and user management"
    },
    {
      "name": "ai",
      "description": "AI-powered task parsing and insights"
    },
    {
      "name": "calendar",
      "description": "Calendar integration"
    },
    {
      "name": "sharing",
      "description": "Task sharing and collaboration"
    },
    {
      "name": "gamification",
      "description": "XP, levels, achievements and leaderboards"
    },
    {
      "name": "marketplace",
      "description": "Task marketplace for trading tasks with XP"
    },
    {
      "name": "social",
      "description": "Team social feed and activity stream"
    },
    {
      "name": "voice",
      "description": "Voice command processing"
    },
    {
      "name": "wiki",
      "description": "Project wiki and knowledge base"
    },
    {
      "name": "meetings",
      "description": "Meeting notes and action item extraction"
    },
    {
      "name": "notifications",
      "description": "Notification digests and preferences"
    },
    {
      "name": "risk",
      "description": "Predictive risk assessment"
    }
  ],
  "paths": {
    "/api/tasks": {
      "get": {
        "tags": ["tasks"],
        "summary": "Get all tasks",
        "description": "Retrieve tasks with optional filtering and sorting",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["today", "next7", "upcoming", "all", "blocked"]
            },
            "description": "Predefined view filter"
          },
          {
            "name": "listId",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Filter by list ID"
          },
          {
            "name": "searchQuery",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Search tasks by name or description"
          },
          {
            "name": "includeCompleted",
            "in": "query",
            "schema": { "type": "boolean", "default": false },
            "description": "Include completed tasks"
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["tasks"],
        "summary": "Create a new task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "tags": ["tasks"],
        "summary": "Get a task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskWithRelations" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["tasks"],
        "summary": "Update a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully"
          }
        }
      },
      "delete": {
        "tags": ["tasks"],
        "summary": "Delete a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted successfully"
          }
        }
      }
    },
    "/api/ai": {
      "post": {
        "tags": ["ai"],
        "summary": "Parse task from natural language",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["parse", "insights"]
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "text": { "type": "string" },
                      "context": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed task suggestion"
          }
        }
      }
    },
    "/api/auth/[...nextauth]/config": {
      "get": {
        "tags": ["auth"],
        "summary": "Get authentication providers",
        "responses": {
          "200": {
            "description": "Available auth providers"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "none"]
          },
          "date": { "type": "string", "format": "date", "nullable": true },
          "deadline": { "type": "string", "format": "date", "nullable": true },
          "completed": { "type": "boolean" },
          "recurring": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "weekdays",
              "monthly",
              "yearly",
              "custom"
            ]
          }
        }
      },
      "TaskWithRelations": {
        "allOf": [
          { "$ref": "#/components/schemas/Task" },
          {
            "type": "object",
            "properties": {
              "labels": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Label" }
              },
              "subtasks": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Subtask" }
              },
              "comments": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Comment" }
              }
            }
          }
        ]
      },
      "CreateTaskInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "list_id": { "type": "integer" },
          "date": { "type": "string", "format": "date" },
          "deadline": { "type": "string", "format": "date" },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "none"]
          },
          "label_ids": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "subtasks": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["name"]
      },
      "UpdateTaskInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "completed": { "type": "boolean" },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "none"]
          }
        }
      },
      "Label": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "Subtask": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "task_id": { "type": "integer" },
          "name": { "type": "string" },
          "completed": { "type": "boolean" }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "task_id": { "type": "integer" },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "TaskSuggestion": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "none"]
          },
          "estimated_duration": { "type": "number", "nullable": true },
          "suggested_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "recurring": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "weekdays",
              "monthly",
              "yearly",
              "custom"
            ]
          },
          "deadline": { "type": "string", "format": "date", "nullable": true }
        }
      }
    },
    "/api/gamification": {
      "get": {
        "tags": ["gamification"],
        "summary": "Get gamification data",
        "description": "Returns leaderboard, user achievements, and current level/XP",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 },
            "description": "Max leaderboard entries"
          }
        ],
        "responses": {
          "200": {
            "description": "Gamification data"
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/marketplace": {
      "get": {
        "tags": ["marketplace"],
        "summary": "List marketplace listings",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "skill", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Listings" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["marketplace"],
        "summary": "Create a marketplace listing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task_id", "price_xp"],
                "properties": {
                  "task_id": { "type": "integer" },
                  "price_xp": { "type": "integer" },
                  "estimated_hours": { "type": "integer", "default": 1 },
                  "required_skills": { "type": "array", "items": { "type": "string" } },
                  "category": { "type": "string", "default": "other" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Listing created" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/social-feed": {
      "get": {
        "tags": ["social"],
        "summary": "Get team activity feed",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "filter", "in": "query", "schema": { "type": "string", "enum": ["all", "team", "following"] } }
        ],
        "responses": {
          "200": { "description": "Feed posts" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["social"],
        "summary": "Create a feed post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["activity_type", "title"],
                "properties": {
                  "activity_type": { "type": "string", "enum": ["task_completed", "streak", "milestone", "achievement", "level_up", "goal_completed"] },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "metadata": { "type": "object" },
                  "visibility": { "type": "string", "enum": ["public", "team", "private"], "default": "team" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Post created" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/voice-control": {
      "post": {
        "tags": ["voice"],
        "summary": "Process a voice command",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["transcript"],
                "properties": {
                  "transcript": { "type": "string" },
                  "execute": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Parsed intent and optional execution result" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/wiki": {
      "get": {
        "tags": ["wiki"],
        "summary": "List or search wiki pages",
        "parameters": [
          { "name": "project_id", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Search query" }
        ],
        "responses": {
          "200": { "description": "Pages array" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["wiki"],
        "summary": "Create a wiki page",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "content"],
                "properties": {
                  "project_id": { "type": "integer", "default": 1 },
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "parent_id": { "type": "integer", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Created page" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/wiki/{id}": {
      "get": {
        "tags": ["wiki"],
        "summary": "Get a wiki page",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "revisions", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": { "description": "Page (and revisions if requested)" },
          "404": { "description": "Page not found" }
        }
      },
      "patch": {
        "tags": ["wiki"],
        "summary": "Update a wiki page",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "changes_summary": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated page" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/meeting-notes": {
      "get": {
        "tags": ["meetings"],
        "summary": "List meeting notes",
        "responses": { "200": { "description": "Notes array" } }
      },
      "post": {
        "tags": ["meetings"],
        "summary": "Create meeting notes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "notes"],
                "properties": {
                  "title": { "type": "string" },
                  "notes": { "type": "string" },
                  "date": { "type": "string", "format": "date" },
                  "participants": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Created notes" } }
      }
    },
    "/api/notifications": {
      "get": {
        "tags": ["notifications"],
        "summary": "Get notification data",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": { "type": "string", "enum": ["digest", "preferences"] }
          }
        ],
        "responses": { "200": { "description": "Digest or preferences" } }
      },
      "post": {
        "tags": ["notifications"],
        "summary": "Update notification preferences or send digest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string", "enum": ["send_digest", "update_preferences"] },
                  "preferences": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Result" } }
      }
    }
  }
}
